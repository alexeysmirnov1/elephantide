<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="500.0" prefWidth="200.0" style="-fx-background-color: transparent;" BorderPane.alignment="CENTER" xmlns="http://javafx.com/javafx/17.0.2-ae" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.git.Presentation.Controllers.GitViewModel">
<children>
      <SplitPane dividerPositions="0.84375" orientation="VERTICAL" style="-fx-background-color: transparent;">
        <items>
          <AnchorPane minHeight="0.0" minWidth="0.0" style="-fx-background-color: transparent;">
               <children>
                  <VBox>
                     <children>
                        <HBox spacing="10.0">
                           <children>
                                <Button mnemonicParsing="false" text="fetch" />
                                <Button layoutX="10.0" layoutY="10.0" mnemonicParsing="false" text="rebase" />
                           </children>
                        </HBox>
                         <VBox fx:id="filesForCommit" spacing="5.0">
                             <children>
                             </children>
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding>
                         </VBox>
                         <TextField fx:id="commitMessage" />
                         <HBox spacing="10.0">
                             <children>
                                 <Button mnemonicParsing="false" onAction="#gitPush" text="push" />
                                 <Button mnemonicParsing="false" onAction="#gitCommit" text="Commit" />
                             </children>
                         </HBox>
                     </children>
                  </VBox>
               </children>
            </AnchorPane>
            <AnchorPane minWidth="-Infinity">
               <children>
                   <VBox fx:id="branches" spacing="5.0">
                       <children>
                       </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                   </VBox>
               </children>
            </AnchorPane>
        </items>
      </SplitPane>
</children>
</VBox>
