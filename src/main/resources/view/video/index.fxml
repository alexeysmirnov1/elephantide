<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import org.fxmisc.flowless.*?>
<?import org.fxmisc.richtext.*?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" styleClass="base" stylesheets="@../../css/editor.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.video.VideoController">
    <top>
        <VBox prefHeight="60.0" spacing="10.0" styleClass="top" BorderPane.alignment="CENTER">
            <children>
                <HBox prefHeight="100.0" prefWidth="200.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" prefWidth="200.0" spacing="15.0" HBox.hgrow="ALWAYS">
                            <children>
                                <HBox spacing="10.0">
                                    <children>
                                        <VBox alignment="BOTTOM_LEFT">
                                            <children>
                                                <HBox alignment="CENTER" fillHeight="false" maxHeight="50.0" prefHeight="50.0" spacing="10.0" styleClass="tab">
                                                    <children>
                                                        <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                                                            <image>
                                                                <Image url="@../../images/extensions/php.png" />
                                                            </image>
                                                        </ImageView>
                                                        <Label fx:id="title" alignment="CENTER_RIGHT" textFill="WHITE">
                                                            <font>
                                                                <Font name="JetBrains Mono Regular" size="16.0" />
                                                            </font>
                                                        </Label>
                                                        <ImageView fitHeight="12.0" fitWidth="12.0" pickOnBounds="true" preserveRatio="true">
                                                            <image>
                                                                <Image url="@../../images/close_tab.png" />
                                                            </image>
                                                        </ImageView>
                                                    </children>
                                                    <padding>
                                                        <Insets left="10.0" right="5.0" />
                                                    </padding>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                           <padding>
                              <Insets right="10.0" />
                           </padding>
                                </HBox>
                                <StackPane prefHeight="40.0" prefWidth="40.0">
                                    <children>
                                        <Circle fill="#00141e" radius="20.0" stroke="BLACK" strokeType="INSIDE" strokeWidth="0.0" />
                                        <Label text="+" textFill="#21272e">
                                            <font>
                                                <Font size="36.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </StackPane>
                            </children>
                     <padding>
                        <Insets left="20.0" />
                     </padding>
                     <HBox.margin>
                        <Insets right="20.0" />
                     </HBox.margin></HBox>
                        <HBox alignment="CENTER" spacing="6.0">
                            <children>
                                <Circle fill="#21ff6f" layoutX="200.0" layoutY="20.0" radius="10.0" stroke="#03bc41" strokeType="INSIDE" />
                                <Circle fill="#ffd621" layoutX="200.0" layoutY="20.0" radius="10.0" stroke="#b8a200" strokeType="INSIDE" />
                                <Circle fill="#ff4e1f" radius="10.0" stroke="#b81400" strokeType="INSIDE" />
                            </children>
                            <padding>
                                <Insets right="20.0" />
                            </padding>
                        </HBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>
    <center>
        <VirtualizedScrollPane HBox.hgrow="ALWAYS">
            <content>
                <StyleClassedTextArea fx:id="codeEditor" cacheShape="false" centerShape="false" onKeyTyped="#updateHighlight" pickOnBounds="false" scaleShape="false" styleClass="editor" wrapText="true" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                </StyleClassedTextArea>
            </content>
        </VirtualizedScrollPane>
    </center>
</BorderPane>
