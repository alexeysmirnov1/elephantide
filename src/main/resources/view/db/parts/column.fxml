<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.Cursor?>

<HBox
        alignment="CENTER_LEFT"
        prefHeight="32.0"
        spacing="5.0"
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        styleClass="discover--item"
>
    <children>
        <ImageView fx:id="icon" fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../../../images/db/column.png" />
            </image>
            <HBox.margin>
                <Insets right="10.0" />
            </HBox.margin>
        </ImageView>
        <Label textFill="WHITE" fx:id="columnName">
            <font>
                <Font name="JetBrains Mono ExtraLight" size="24.0" />
            </font>
        </Label>
    </children>
    <cursor>
        <Cursor fx:constant="HAND" />
    </cursor>
    <padding>
        <Insets bottom="3.0" left="10.0" right="10.0" top="3.0" />
    </padding>
</HBox>
