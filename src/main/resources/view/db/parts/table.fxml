<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.Cursor?>

<HBox
        alignment="CENTER_LEFT"
        prefHeight="32.0"
        spacing="5.0"
        xmlns="http://javafx.com/javafx/17.0.2-ea"
        xmlns:fx="http://javafx.com/fxml/1"
>
    <children>
        <VBox alignment="CENTER_LEFT" prefHeight="32.0" HBox.hgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="32.0" styleClass="discover--item">
                    <children>
                        <ImageView fx:id="icon" fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../../images/db/table.png" />
                            </image>
                            <HBox.margin>
                                <Insets right="10.0" />
                            </HBox.margin>
                        </ImageView>
                        <Label fx:id="dirName" textFill="WHITE">
                            <font>
                                <Font name="JetBrains Mono ExtraLight" size="24.0" />
                            </font>
                        </Label>
                    </children>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                    <padding>
                        <Insets bottom="3.0" left="10.0" right="10.0" top="3.0" />
                    </padding>
                </HBox>
                <VBox fx:id="children" prefHeight="200.0">
                    <VBox.margin>
                        <Insets left="30.0" />
                    </VBox.margin>
                </VBox>
            </children>
        </VBox>
    </children>
</HBox>
