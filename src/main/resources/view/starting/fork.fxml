<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.Cursor?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1000.0" styleClass="base" stylesheets="@../../css/starting.css" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.ide.Infrastructure.Controllers.Starting.ForkController">
   <center>
      <HBox alignment="CENTER" spacing="40.0">
         <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
            <children>
               <ImageView fitHeight="200.0" fitWidth="200.0" onMouseClicked="#createNewProject" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../../images/new_project.png" />
                  </image>
                  <cursor>
                     <Cursor fx:constant="HAND" />
                  </cursor>
               </ImageView>
               <Label text="New Project" textFill="WHITE">
                  <VBox.margin>
                     <Insets top="20.0" />
                  </VBox.margin>
                  <font>
                     <Font name="JetBrains Mono Regular" size="24.0" />
                  </font>
               </Label>
            </children>
         </VBox>
         <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
            <children>
               <ImageView fitHeight="200.0" fitWidth="200.0" onMouseClicked="#openExistsProject" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../../images/open_project.png" />
                  </image>
                  <cursor>
                     <Cursor fx:constant="HAND" />
                  </cursor>
               </ImageView>
               <Label text="Open Project" textFill="WHITE">
                  <font>
                     <Font name="JetBrains Mono Regular" size="24.0" />
                  </font>
                  <VBox.margin>
                     <Insets top="20.0" />
                  </VBox.margin>
               </Label>
            </children>
         </VBox>
      </HBox>
   </center>
</BorderPane>
