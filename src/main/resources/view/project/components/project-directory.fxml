<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefWidth="400.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="title">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <Label fx:id="path" alignment="CENTER_RIGHT" prefWidth="400.0" textAlignment="RIGHT" textFill="DARKGRAY">
            <font>
                <Font size="14.0" />
            </font>
        </Label>
    </children>
   <cursor>
      <Cursor fx:constant="HAND" />
   </cursor>
</VBox>
