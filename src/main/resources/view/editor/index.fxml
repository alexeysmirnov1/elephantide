<BorderPane prefHeight="700.0" prefWidth="1000.0" styleClass="base" stylesheets="@../../css/editor.css" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.ide.Infrastructure.Controllers.Editor.EditorController">
<center>
      <VBox>
         <children>
            <Label alignment="CENTER" contentDisplay="CENTER" maxHeight="30.0" maxWidth="1.7976931348623157E308" prefHeight="30.0" styleClass="project-name" text="fitlar" textAlignment="CENTER" textFill="#00db7c">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
            <StackPane VBox.vgrow="ALWAYS">
               <children>
                  <VirtualizedScrollPane>
                     <content>
                        <StyleClassedTextArea fx:id="codeEditor" cacheShape="false" centerShape="false" onKeyTyped="#changedContent" pickOnBounds="false" scaleShape="false" styleClass="editor" wrapText="true" VBox.vgrow="ALWAYS">
                           <padding>
                              <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                           </padding>
                        </StyleClassedTextArea>
                     </content>
                  </VirtualizedScrollPane>
                  <VBox fx:id="projectDiscover" maxWidth="200.0" prefHeight="200.0" prefWidth="150.0" styleClass="bg" BorderPane.alignment="CENTER" StackPane.alignment="CENTER_LEFT">
                     <children>
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
               </children>
            </StackPane>
         </children>
      </VBox>
</center>
   <top>
      <HBox prefHeight="60.0" spacing="10.0" styleClass="top" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" prefWidth="200.0" spacing="15.0" HBox.hgrow="ALWAYS">
               <children>
                  <HBox fx:id="tabPanel" spacing="10.0">
                     <children>
                     </children>
                  </HBox>
                  <StackPane onMouseClicked="#openFile" prefHeight="40.0" prefWidth="40.0">
                     <children>
                        <Circle fill="#00141e" radius="20.0" stroke="BLACK" strokeType="INSIDE" strokeWidth="0.0" />
                        <Label text="+" textFill="#21272e">
                           <font>
                              <Font size="36.0" />
                           </font>
                        </Label>
                     </children>
                  </StackPane>
               </children>
               <padding>
                  <Insets left="20.0" />
               </padding></HBox>
            <HBox alignment="CENTER" spacing="6.0">
               <children>
                  <Circle fill="#21ff6f" layoutX="200.0" layoutY="20.0" radius="10.0" stroke="BLACK" strokeType="INSIDE" strokeWidth="0.0" />
                  <Circle fill="#ffd621" layoutX="200.0" layoutY="20.0" radius="10.0" stroke="BLACK" strokeType="INSIDE" strokeWidth="0.0" />
                  <Circle fill="#ff4e1f" radius="10.0" stroke="BLACK" strokeType="INSIDE" strokeWidth="0.0" />
               </children>
               <padding>
                  <Insets right="20.0" />
               </padding>
            </HBox>
         </children>
      </HBox>
   </top>
</BorderPane>
